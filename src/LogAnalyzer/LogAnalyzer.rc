#include "resource.h"
#include <windows.h>
#include <commctrl.h>

// ── Main dockable panel  (440 x 700 dialog units) ────────────────────────────
IDD_LOG_ANALYZER_DIALOG DIALOGEX 0, 0, 440, 700
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    // ── Row 1 – Folder ────────────────────────────────────────────────────
    LTEXT           "Folder:",IDC_STATIC,           4,  5, 32,  9
    EDITTEXT        1001,                           38,  3,302, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",1002,                 344,  2, 90, 15

    // ── Row 2 – Regex pattern ─────────────────────────────────────────────
    LTEXT           "Regex:",IDC_STATIC,            4, 22, 32,  9
    EDITTEXT        1003,                           38, 20,396, 13, ES_AUTOHSCROLL

    // ── Row 3 – Timestamp / Recursive / Bucket / Process ─────────────────
    LTEXT           "Timestamp:",IDC_STATIC,        4, 39, 46,  9
    EDITTEXT        1004,                           52, 37,140, 13, ES_AUTOHSCROLL
    CONTROL         "Recursive",1005,"Button",BS_AUTOCHECKBOX|WS_TABSTOP,
                                                  198, 39, 58, 10
    LTEXT           "Bucket:",IDC_STATIC,          260, 39, 32,  9
    EDITTEXT        1013,                          294, 37, 30, 13, ES_AUTOHSCROLL|ES_NUMBER
    COMBOBOX        1012,                          326, 36, 60, 80, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    PUSHBUTTON      "Process",1006,               390, 35, 46, 16

    // ── Row 4 – Search / Level / Filter ──────────────────────────────────
    LTEXT           "Search:",IDC_STATIC,           4, 57, 32,  9
    EDITTEXT        1014,                           38, 55,190, 13, ES_AUTOHSCROLL
    CONTROL         "Regex",1015,"Button",BS_AUTOCHECKBOX|WS_TABSTOP,
                                                  232, 57, 36, 10
    LTEXT           "Level:",IDC_STATIC,           272, 57, 28,  9
    COMBOBOX        1007,                          302, 55, 88, 80, CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    PUSHBUTTON      "Filter",1009,                394, 54, 42, 16

    // ── Row 5 – Keywords ─────────────────────────────────────────────────
    LTEXT           "Keywords:",IDC_STATIC,         4, 74, 42,  9
    EDITTEXT        1008,                           48, 72,388, 13, ES_AUTOHSCROLL

    // ── Histogram (custom GDI control) ────────────────────────────────────
    LTEXT           "Timeline",IDC_STATIC,          4, 90, 36,  9
    CONTROL         "",1017,"LogAnalyzerHistogram",WS_CHILD|WS_VISIBLE|WS_BORDER,
                                                    4,100,432,100

    // ── Tab control ───────────────────────────────────────────────────────
    CONTROL         "",1018,"SysTabControl32",TCS_FIXEDWIDTH|WS_TABSTOP,
                                                    4,205,432, 18

    // ── Logs list (virtual / LVS_OWNERDATA) ──────────────────────────────
    CONTROL         "",1010,"SysListView32",
                    LVS_REPORT|LVS_OWNERDATA|LVS_SHOWSELALWAYS|LVS_SINGLESEL|WS_BORDER|WS_TABSTOP,
                    4,223,432,440

    // ── Patterns list (hidden by default) ────────────────────────────────
    CONTROL         "",1019,"SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|LVS_SINGLESEL|WS_BORDER|WS_TABSTOP,
                    4,223,432,440

    // ── Exceptions list (hidden by default) ──────────────────────────────
    CONTROL         "",1020,"SysListView32",
                    LVS_REPORT|LVS_SHOWSELALWAYS|LVS_SINGLESEL|WS_BORDER|WS_TABSTOP,
                    4,223,432,440

    // ── Status bar ────────────────────────────────────────────────────────
    LTEXT           "Ready",1011,4,667,432,9
END

// ── Row detail popup ─────────────────────────────────────────────────────────
IDD_LOG_DETAIL DIALOGEX 0, 0, 420, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Log Entry Detail"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT    "Time:",   IDC_STATIC, 8,  8, 28, 9
    LTEXT    "",        1100,      40,  8,370, 9
    LTEXT    "Level:",  IDC_STATIC, 8, 22, 28, 9
    LTEXT    "",        1101,      40, 22,100, 9
    LTEXT    "Source:", IDC_STATIC, 8, 36, 30, 9
    LTEXT    "",        1102,      40, 36,370, 9
    LTEXT    "Message:",IDC_STATIC, 8, 50, 38, 9
    EDITTEXT 1103,                  8, 62,404, 80, ES_MULTILINE|ES_AUTOVSCROLL|ES_READONLY|WS_VSCROLL
    LTEXT    "Raw:",    IDC_STATIC, 8,148, 20, 9
    EDITTEXT 1104,                  8,160,404, 80, ES_MULTILINE|ES_AUTOVSCROLL|ES_READONLY|WS_VSCROLL
    DEFPUSHBUTTON "Close", IDOK,  175,248, 70, 14
END
