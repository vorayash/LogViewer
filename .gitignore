# Test logs and outputs
test_logs/
*.test.log

# ============================================
# FOLDERS TO EXCLUDE FROM VERSION CONTROL
# ============================================
# 
# vs.proj/Debug/          - Debug build outputs
# vs.proj/Release/        - Release build outputs  
# vs.proj/x64/            - x64 platform builds
# vs.proj/ARM64/          - ARM64 platform builds
# vs.proj/.vs/            - Visual Studio cache
# vs.proj/NppPlugi.*/     - Intermediate build files
# bin/                    - 32-bit release output
# bin64/                  - 64-bit release output
# arm64/                  - ARM64 release output
# .vscode/                - VS Code settings (optional)
# .vs/                    - Visual Studio settings
